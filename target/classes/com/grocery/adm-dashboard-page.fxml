<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox minHeight="600.0" minWidth="900.0" maxHeight="Infinity" maxWidth="Infinity" stylesheets="@../../styles/adm-dsh-styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.grocery.controller.AdmDBController">
   <children>

      <HBox alignment="CENTER_LEFT" spacing="10.0" maxWidth="Infinity">
         <padding><Insets bottom="5.0" left="10.0" right="10.0" top="5.0" /></padding>
         <children>
            <Label text="Welcome,">
               <font><Font size="14.0" /></font>
            </Label>
            <Label fx:id="adm_name" text="Name">
               <font><Font size="14.0" /></font>
            </Label>
         </children>
      </HBox>

      <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" maxWidth="Infinity">
         <tabs>
            <Tab text="Alerts">
               <content>
                  <StackPane>
                     <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                     <children>
                        <ListView fx:id="alert_list" fixedCellSize="50.0" />
                     </children>
                  </StackPane>
               </content>
            </Tab>

            <Tab fx:id="prod_tab" text="Products">
               <content>
                  <VBox spacing="10.0" maxWidth="Infinity" fillWidth="true">
                     <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                     <children>
                        <HBox spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                           <children>
                              <Label text="Products" styleClass="section_label" />
                              <Button onAction="#reg_pro_btn" text="Register Product" />
                              <Button onAction="#gen_inv_rep_btn" text="Generate Inventory Report" />
                              <Button fx:id="save_chngs" onAction="#save_chngs" text="Save Changes" />
                              <Region HBox.hgrow="ALWAYS" />
                              <CheckBox fx:id="select_all" onAction="#select_all_products" text="SelectAll" />
                              <Button fx:id="del_prd_btn" onAction="#re_prod_btn" styleClass="del_btn" text="🗑" />
                           </children>
                        </HBox>

                        <HBox spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                           <children>
                              <TextField fx:id="search_field" onAction="#search" HBox.hgrow="ALWAYS" />
                              <Button onAction="#search" text="🔍" />
                              <Button onAction="#refresh_prod" text="⟳" />
                           </children>
                        </HBox>

                        <TableView fx:id="productTable" VBox.vgrow="ALWAYS" maxWidth="Infinity">
                           <columns>
                              <TableColumn fx:id="colId" text="ID" prefWidth="${productTable.width * 0.18}"/>
                              <TableColumn fx:id="colName" onEditCommit="#edit_prodName" text="Item Name" prefWidth="${productTable.width * 0.32}" />
                              <TableColumn fx:id="colBatch" onEditCommit="#edit_prodBtchNum" text="Batch Num" prefWidth="${productTable.width * 0.11}" />
                              <TableColumn fx:id="colPrice" onEditCommit="#edit_prodPrice" text="Price" prefWidth="${productTable.width * 0.09}" />
                              <TableColumn fx:id="colExpiry" onEditCommit="#edit_prodExpDate" text="Expiry Date" prefWidth="${productTable.width * 0.16}" />
                              <TableColumn fx:id="colStock" onEditCommit="#edit_prodNoStock" text="No. of Stock" prefWidth="${productTable.width * 0.12}" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </content>
            </Tab>

            <Tab text="Staff">
               <content>
                  <VBox spacing="10.0" maxWidth="Infinity" fillWidth="true">
                     <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                     <children>
                        <HBox spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                           <children>
                              <Button onAction="#create_staff_btn" text="Create Staff" />
                              <Button fx:id="adm_perm_btn" onAction="#adm_perm_btn" text="Give Admin Permit" />
                              <Button fx:id="del_stf_btn" onAction="#rem_staff_btn" styleClass="del_btn" text="Remove Staff" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button onAction="#refresh_stf" text="⟳" />
                           </children>
                        </HBox>

                        <TableView fx:id="staffTable" VBox.vgrow="ALWAYS" maxWidth="Infinity">
                           <columns>
                              <TableColumn fx:id="colStaffId" text="Staff ID" prefWidth="${staffTable.width * 0.20}"/>
                              <TableColumn fx:id="colStaffName" text="Employee Name" prefWidth="${staffTable.width * 0.55}"/>
                              <TableColumn fx:id="colStaffRole" text="Role Status" prefWidth="${staffTable.width * 0.25}"/>
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>

      <HBox alignment="CENTER_RIGHT" maxWidth="Infinity">
         <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
         <children>
            <Button onAction="#logout_btn" text="Logout" />
         </children>
      </HBox>

   </children>
</VBox>