<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="mainPane" alignment="CENTER" spacing="30.0" maxHeight="Infinity" maxWidth="Infinity" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.grocery.controller.RegisterProductController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <children>
        <Label fx:id="title_label" text="Modify Product">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Label>

        <GridPane alignment="CENTER" hgap="15.0" vgap="15.0" maxWidth="500.0">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" halignment="LEFT" minWidth="150.0" prefWidth="170.0" />
                <ColumnConstraints hgrow="ALWAYS" halignment="LEFT" />
            </columnConstraints>

            <children>
                <Label text="Product Serial Number:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <font><Font size="14.0" /></font>
                </Label>
                <TextField fx:id="prod_id" prefHeight="35.0" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Batch No.:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <font><Font size="14.0" /></font>
                </Label>
                <TextField fx:id="prod_batchno" prefHeight="35.0" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Product Name:" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <font><Font size="14.0" /></font>
                </Label>
                <TextField fx:id="prod_name" prefHeight="35.0" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Stock Amount:" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <font><Font size="14.0" /></font>
                </Label>
                <Spinner fx:id="prod_amt" editable="true" prefHeight="35.0" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Price:" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <font><Font size="14.0" /></font>
                </Label>
                <Spinner fx:id="prod_price" editable="true" prefHeight="35.0" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Expiry Date:" GridPane.columnIndex="0" GridPane.rowIndex="5">
                    <font><Font size="14.0" /></font>
                </Label>
                <DatePicker fx:id="expiry_date" prefHeight="35.0" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
        </GridPane>

        <Button mnemonicParsing="false" onAction="#submit_btn" onKeyPressed="#submit_btn" prefHeight="40.0" prefWidth="200.0" text="OK">
            <font>
                <Font size="14.0" />
            </font>
        </Button>
    </children>
</VBox>