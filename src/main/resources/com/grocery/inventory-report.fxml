<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" maxHeight="Infinity" maxWidth="Infinity" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.grocery.controller.InventoryReportController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <children>
        <Label alignment="CENTER" maxWidth="Infinity" text="Inventory Report">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <VBox spacing="15.0">
            <children>
                <HBox spacing="15.0" maxWidth="Infinity">
                    <children>
                        <Button mnemonicParsing="false" onAction="#gen_daily" prefHeight="35.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" text="Generate Daily Report" />
                        <Button mnemonicParsing="false" onAction="#gen_weekly" prefHeight="35.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" text="Generate Weekly Report" />
                        <Button mnemonicParsing="false" onAction="#gen_monthly" prefHeight="35.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" text="Generate Monthly Report" />
                    </children>
                </HBox>

                <HBox spacing="15.0" alignment="CENTER">
                    <children>
                        <Button mnemonicParsing="false" onAction="#gen_cust" prefHeight="35.0" text="Generate Custom Report" />
                        <DatePicker fx:id="cust" prefHeight="35.0" promptText="Select Date..." />
                    </children>
                </HBox>
            </children>
        </VBox>

        <TableView fx:id="mainTable" VBox.vgrow="ALWAYS" maxWidth="Infinity">
            <columns>
                <TableColumn fx:id="colDate" text="Date" prefWidth="${mainTable.width * 0.10}" />
                <TableColumn fx:id="colHr" text="Hour" prefWidth="${mainTable.width * 0.08}" />
                <TableColumn fx:id="colName" text="Item Name" prefWidth="${mainTable.width * 0.28}" />
                <TableColumn fx:id="colStock" text="No. of Stock" prefWidth="${mainTable.width * 0.12}" />
                <TableColumn fx:id="colPrice" text="Price" prefWidth="${mainTable.width * 0.10}" />
                <TableColumn fx:id="colAdd" text="Total Added" prefWidth="${mainTable.width * 0.15}" />
                <TableColumn fx:id="colRem" text="Total Removed" prefWidth="${mainTable.width * 0.15}" />
            </columns>
        </TableView>

    </children>
</VBox>